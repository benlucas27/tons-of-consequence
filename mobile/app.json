{
  "expo": {
    "name": "Tons of Consequence",
    "slug": "tons-of-consequence",
    "scheme": "tonsofconsequence",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1c13",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tonsofconsequence.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tonsofconsequence.app"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0b1c13",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f2ed77c0-7045-4c6e-b5ed-862e9e705b84"
      },
      "oneSignalAppId": "REPLACE-WITH-ONESIGNAL-APP-ID"
    },
    "owner": "blucas27s-team",
    "icon": "./assets/icon.png"
  }
}
