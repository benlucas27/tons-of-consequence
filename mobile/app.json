{
  "expo": {
    "name": "Tons of Consequence",
    "slug": "tons-of-consequence",
    "scheme": "tonsofconsequence",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1c13",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tonsofconsequence.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tonsofconsequence.app"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
